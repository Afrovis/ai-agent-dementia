# Copy this file to `.env` and adjust as needed. No secrets belong here in v1;
# see HANDOFF.md section 10 for what gets documented where.

# Redis bus (the `bus` service, redis-streams). All services other than `bus`
# read this to connect.
REDIS_URL=redis://bus:6379

# IANA timezone `agent` reads its "local" wall clock in (AGENT_NIGHT_START/
# AGENT_NIGHT_END below are local `HH:MM`). Docker containers default to
# UTC regardless of the host's clock, so leaving this unset or wrong makes
# the night window open and close at the wrong hour -- e.g. a bedside
# device in Central European Time would run a 21:00-07:00 window at
# 23:00-09:00 local time, sitting idle for the first two hours of the
# night. Not guessed here: set it to your own zone, e.g. "Europe/Brussels"
# or "America/New_York".
TZ=UTC

# Ollama runs on the host, not in a container, reached from containers via
# Docker's host gateway (HANDOFF.md section 2).
OLLAMA_URL=http://host.docker.internal:11434

# `agent` (issue #15): local Ollama text model for structured
# interpret/compose/plan calls. Images and audio are never sent to this model.
# The default is the same model as PERCEIVE_FLOOR_CHECK_MODEL, so Ollama keeps
# one copy in memory for both.
AGENT_LLM_MODEL=gemma4:e4b-mlx

# `agent`: hard request timeout for one local text-model call. The product
# latency targets remain <1s for interpret and <2s to first token for
# compose/plan; this ceiling also allows a cold local model load to finish.
AGENT_LLM_TIMEOUT_SECONDS=10

# `agent`: local text-model transport. `ollama` (default) uses OLLAMA_URL.
# `openai` talks to an OpenAI-compatible server on the host, e.g.
# `mlx_lm.server --model mlx-community/gemma-4-e4b-it-4bit --port 11435`
# (Metal is not available inside Docker, so MLX must run on the host). With
# `openai`, AGENT_LLM_MODEL is that server's model id and AGENT_LLM_URL its
# base URL. Either way every call stays on this machine. On a 16 GB Mac an MLX
# server next to the Ollama models perception uses exhausted memory and froze
# the machine, so keep `ollama` there.
AGENT_LLM_BACKEND=ollama
AGENT_LLM_URL=http://host.docker.internal:11435

# `agent` (issue #25): credential used only when the caregiver explicitly
# enables text-only cloud fallback in config/person.yaml or on the Profile
# page. Leave blank to keep every model call local. Never commit a real key.
ANTHROPIC_API_KEY=

# `agent` (issue #16): caregiver-authored person profile. The compose file
# mounts ./config at /app/config. If person.yaml is absent, the loader uses
# person.example.yaml beside it, then safe generic defaults if neither works.
# Profile values are supplied only to the local text model and are never logged.
PERSON_PATH=/app/config/person.yaml

# SQLite file written by the `store` service, as a path inside the
# container. The compose file mounts ./data on the host to /app/data, so
# this ends up at ./data/night.db on the host.
DB_PATH=/app/data/night.db

# `store` (issue #24): local time to publish the prior night's caregiver
# summary. The summary includes wake-up count, durations, the final spoken
# strategy before each non-escalated resolution, health faults, and escalations.
# A durable marker in SQLite prevents a restart from sending it twice.
MORNING_SUMMARY_TIME=08:00

# `store` and `dashboard` (issue #26): persisted event history, including
# transcripts and cloud-call payloads, is deleted after this many days. The
# System page displays the same value and provides authenticated export/delete.
# Profile settings and uploaded media are not automatically expired.
DATA_RETENTION_DAYS=90

# Issue #27 volunteer evaluation mode. When true, the notify service suppresses
# every outbound caregiver notification even if NTFY_URL is configured. Notify
# events are still stored and shown in Tonight/History, and the System page
# displays a prominent warning. Use only for the supervised volunteer dry run;
# set back to false before any real-care pilot and restart notify and dashboard.
DRY_RUN=false

# Port the `embodiment` fullscreen web page listens on and is published on.
EMBODIMENT_PORT=8443

# Bedside day/night icon boundaries and optional 24-hour clock.
EMBODIMENT_NIGHT_START=20:00
EMBODIMENT_NIGHT_END=07:00
EMBODIMENT_CLOCK_24H=false
# Live-pipeline debug controls on the bedside debug overlay (press D): shift
# the agent's time of day by whole hours, force the agent to treat the person
# as in bed, and trace the bed zone from the camera when none is configured.
# The bedside page has no login, and forcing "in bed" silences the night
# logic, so leave this false outside desk testing. Restart embodiment after
# changing it.
EMBODIMENT_DEBUG_CONTROLS=false

# mkcert LAN certificate for the `embodiment` page (HANDOFF.md section 9).
# Paths are inside the container; the compose file mounts ./data on the host
# to /app/data, so these default to ./data/certs/lan*.pem on the host. If
# missing, `embodiment` falls back to plain HTTP (getUserMedia will then
# only work on localhost).
CERT_FILE=/app/data/certs/lan.pem
CERT_KEY=/app/data/certs/lan-key.pem

# Directory the `embodiment` page serves caregiver-uploaded photos from,
# as a path inside the container. A `Show` event's `photo_id` is looked up
# here as `<photo_id>.jpg/.jpeg/.png/.webp`. The compose file mounts ./data
# on the host to /app/data, so this is ./data/photos on the host. Missing
# photos answer 404 and the page simply shows no photo.
PHOTO_DIR=/app/data/photos

# `dashboard` stores family-recorded voice clips here after validating them
# as bounded PCM WAV files. `agent` checks configured familiar_voice clips
# here during selection, and `embodiment` serves them for playback. Clips stay
# local and are never placed on Redis; all three services share the ./data mount.
VOICE_CLIP_DIR=/app/data/voice-clips

# `embodiment` (issue #19): Piper runs locally and renders every Say event
# into a WAV fetched by the bedside browser over the same HTTPS origin.
# The image downloads this voice at build time; generated WAVs stay in an
# ephemeral container cache so spoken audio is not retained. Piper uses 1.0
# as normal speed, so 0.85 is the deliberately warm, slower night voice from
# PLAN.md section 7.
PIPER_VOICE_MODEL=/app/models/piper/en_US-lessac-medium.onnx
PIPER_CACHE_DIR=/tmp/night-companion-tts
PIPER_SPEED=0.85

# Port the caregiver `dashboard` web app listens on and is published on.
DASHBOARD_PORT=8444

# `dashboard` (issue #10): the single password protecting every dashboard
# route (PLAN.md section 9: "LAN-only web app, protected by a single
# password. No cloud account."). Checked with HTTP Basic auth over plain
# HTTP -- fine given PLAN.md section 10's threat model, "a device on the
# home LAN", not a hostile network. If this is unset or empty, `dashboard`
# still starts but every route answers 503 rather than inventing a
# default or serving a live bedroom camera frame unauthenticated. Set it
# to something a caregiver can type on a phone keyboard.
# Must be ASCII only: HTTP Basic cannot carry anything else, and the
# dashboard refuses to start on a password it could never accept.
DASHBOARD_PASSWORD=

# `capture` (issue #7): which frame source to use. `browser` reads the
# `frames_raw` events the embodiment media bridge publishes (MVP, default).
# `usb` and `rtsp` read a camera directly via OpenCV (v1, needs the
# `camera` extra installed).
CAPTURE_SOURCE=browser

# `capture`: the USB camera index (as a string, e.g. "0") when
# CAPTURE_SOURCE=usb, or the RTSP URL when CAPTURE_SOURCE=rtsp. Unused for
# CAPTURE_SOURCE=browser.
CAPTURE_DEVICE=0

# `capture`: frames per second to publish while the scene is moving.
CAPTURE_FPS=2.0

# `capture`: frames per second to publish once the scene has been static
# for CAPTURE_STATIC_SECONDS -- a slow heartbeat, not silence, so `perceive`
# still sees a live stream on a quiet night (HANDOFF.md rule 4).
CAPTURE_IDLE_FPS=0.5

# `capture`: seconds with no detected motion before dropping from
# CAPTURE_FPS to CAPTURE_IDLE_FPS.
CAPTURE_STATIC_SECONDS=30

# `capture`: minimum normalised frame difference (0.0-1.0) to count as
# motion. Lower is more sensitive; raise it if IR grain or JPEG noise keeps
# the gate from ever going idle.
CAPTURE_MOTION_THRESHOLD=0.02

# `perceive` (issue #8): which pose backend to run frames through.
# `yolo` is the default: on the 640x480 bridge frame, YOLO11s-pose found far
# more floor falls than MediaPipe, the nano model, or YOLOv8s-pose (which
# locks onto a static object on the bed instead of the fallen person on one
# recorded fall) did at the bridge's old 320x240 (HANDOFF.md section 12 has
# the comparison; see also docs/FLOOR_DETECTION_HANDOFF.md). `yolo` needs
# the `yolo` extra installed; `mediapipe` needs the `mediapipe` extra
# instead. `scripted` needs neither installed and always reports "no
# person seen" -- useful for smoke-testing
# the rest of the pipeline with no model weights, but real scripted
# sequences for tests and the perception bench (issue #11) are built
# directly in code, not through this env var.
PERCEIVE_POSE_BACKEND=yolo

# `perceive`: weights file for PERCEIVE_POSE_BACKEND=yolo. `yolo11s-pose.pt`
# is the default: at the bridge's 640x480 frame it detects far more floor
# falls than `yolov8n-pose.pt` (nano) does, at around 57 ms/frame on CPU,
# still well inside the 2 fps budget, and unlike `yolov8s-pose.pt` it does
# not lock onto a static object on the bed instead of the fallen person.
# The perceive image bakes these weights in at build time so nothing
# downloads at runtime; ultralytics would otherwise download a missing
# file by name on first use.
PERCEIVE_YOLO_MODEL=yolo11s-pose.pt

# `perceive`: inference resolution (long side, pixels) passed explicitly to
# the YOLO backend for PERCEIVE_POSE_BACKEND=yolo, matching the bridge's
# 640x480 frame.
PERCEIVE_YOLO_IMGSZ=640

# `perceive`: path to a calibrated list of known phantom boxes -- fixed
# non-person objects (a lamp, a headboard corner) the YOLO backend reports
# as "person" with an unmoving box, including in an empty room. Only
# meaningful for PERCEIVE_POSE_BACKEND=yolo. Unset (the default) means the
# filter is off entirely. Produce this file by running
# `python -m perceive.calibrate_phantoms` with the room empty (see
# CLAUDE.md Gotchas); restart perceive after writing or updating it. An
# earlier design tried to learn phantoms live from runtime co-occurrence
# instead of calibrating them ahead of time; it turned out both
# ineffective (on the real 2026-09-14 bedroom clips the phantom and the
# real person never actually appear in the same frame) and unsafe (a
# sleeping person's own static box could get permanently misflagged by an
# unrelated mover elsewhere in frame). See perceive/phantom.py.
PERCEIVE_PHANTOMS_FILE=

# `perceive`: a candidate overlapping a known phantom box (IoU >= 0.85) is
# only excluded if its own confidence is below this. A strong detection in
# that exact box is trusted over the calibration.
PERCEIVE_PHANTOM_MAX_CONFIDENCE=0.7

# `perceive`: run MediaPipe in video mode (frame-to-frame tracking) instead
# of independent single-image detection. Only meaningful for
# PERCEIVE_POSE_BACKEND=mediapipe. Off by default; measure on the
# perception bench before turning it on.
PERCEIVE_MEDIAPIPE_VIDEO_MODE=false

# `perceive`: below this overall pose-detection confidence (0.0-1.0), a
# frame is treated as "no person seen" (state `absent`) rather than trust
# a shaky detection.
PERCEIVE_MIN_CONFIDENCE=0.5

# `perceive`: a detection at or above this confidence but below
# PERCEIVE_MIN_CONFIDENCE proves someone is in frame without being good
# enough to read a posture from. In the bed zone that counts as `in_bed`;
# elsewhere it holds the current state instead of reporting `absent`. On
# the 2026-09-13 bedroom clips most in-bed YOLO detections scored 0.25-0.5
# and the 0.5 cut-off alone turned them into absence. Set equal to
# PERCEIVE_MIN_CONFIDENCE to disable.
PERCEIVE_PRESENCE_CONFIDENCE=0.25

# `perceive`: outside the bed zone, a confident detection whose bounding-box
# top sits at or below this height (0.0 top of frame, 1.0 bottom) is
# `on_floor`, whatever its shape. The lying-shape test alone missed every
# floor event on the 2026-09-13 clips: people sitting, kneeling or
# foreshortened on the floor have boxes taller than wide. Depends on camera
# height; values above 1.0 disable the rule.
PERCEIVE_FLOOR_TOP_Y=1.01

# `perceive`: seconds of seeing nobody before `absent` is reported; until
# then the last state is held. One- or two-frame detector dropouts are
# noise, and the agent already waits AGENT_ABSENT_LIMIT_SECONDS before
# acting on `absent`. 0 reports it on the first empty frame.
PERCEIVE_ABSENT_CONFIRM_SECONDS=3

# `perceive`: a person lost while last seen in the bed zone confirms
# `in_bed` instead of `absent`. Getting under the blanket is the moment the
# detector loses them, so a lying pose is often never seen first. Never
# applied to someone last seen walking. Draw real zones before enabling:
# `python -m perceive.calibrate_bed` traces the bed zone from the camera
# image (see CLAUDE.md Gotchas).
PERCEIVE_BED_VANISH_HOLD=false

# `perceive`: an upright person whose visible thigh drops less than this
# fraction of their torso length is seated rather than standing, so someone
# sitting on the bed edge with their feet on the floor stays on the bed
# instead of reading as `standing`. 0.55 separates seated from standing on
# the 2026-09-13/14 clips; 0 (the default) disables it. Enable together with
# PERCEIVE_BED_VANISH_HOLD after running `perceive.calibrate_bed`: with a bed
# zone that also covers a chair or the floor in front of the bed, seated
# people there become false in-bed readings.
PERCEIVE_SITTING_THIGH_RATIO=0

# `perceive`: keep reporting `on_floor` while the person is hidden (for
# example behind the bed), as the bed hold does for `in_bed`.
PERCEIVE_HOLD_FLOOR=true

# `perceive`: consecutive agreeing frame classifications required before a
# state change is published, to stop a single bad frame (IR grain, a
# momentary occlusion) from flapping the agent between phases. Does not
# apply to `on_floor` or `absent`, which always publish immediately
# (HANDOFF.md rule 5; PLAN.md section 12's 2 s latency target).
PERCEIVE_CONFIRM_FRAMES=3

# `perceive`: how long to keep reporting `in_bed` after the pose model
# stops seeing anyone, in seconds. 0, the default, means indefinitely. A
# blanket defeats pose models, so a covered sleeper looking like an empty
# room is the expected night-time reading, not a fault. Reporting `absent`
# there would ring the caregiver's phone on a quiet night, and leaving the
# bed is a transition the model does see, so holding is the safer default.
# Set a positive value to time the hold out instead.
PERCEIVE_BED_HOLD_SECONDS=0

# `perceive`: minimum horizontal centroid displacement (0.0-1.0, fraction
# of frame width) across recent frames for a `standing` person to be
# reclassified as `walking` (PERCEIVE_WALK_MODE=legacy). 0.08 with
# PERCEIVE_CONFIRM_FRAMES=2 doubled walking F1 on the 2026-09-13/14 clips
# (docs/WALKING_BED_OCCUPANCY_PLAN.md section 4).
PERCEIVE_WALK_THRESHOLD=0.15

# `perceive`: how `walking` is told from `standing`. `legacy` uses the
# threshold above; `ground` tracks the feet over PERCEIVE_WALK_WINDOW_SECONDS
# and also sees walking towards or away from the camera, but did not beat
# `legacy` on the current (coarse) reference labels, so it is opt-in.
PERCEIVE_WALK_MODE=legacy
PERCEIVE_WALK_MOTION_THRESHOLD=0.35
PERCEIVE_WALK_WINDOW_SECONDS=2

# `perceive`: report a standing/walking person's zone from their feet, not
# their body centre. Someone walking between the camera and the bed covers
# the bed in the image; with this on they no longer read as in the bed zone
# (86 -> 20 such frames on the 2026-09-13/14 clips). Recommended together
# with a `perceive.calibrate_bed` zone.
PERCEIVE_UPRIGHT_ZONE_FROM_FEET=false

# `perceive`: sticky bed occupancy. Once `in_bed` is confirmed, an upright
# frame with the feet still on the bed and no walking reads `sitting_up`
# (still wakes the agent) instead of `standing` (out of bed), until the feet
# leave the bed zone, the person walks, or `on_floor`. No measurable effect
# on the current clips once the bed zone is segmented; meant for rooms where
# the bed zone cannot be drawn tightly.
PERCEIVE_BED_LATCH=false

# `perceive`: maximum seconds between `PersonState` publishes, even when
# nothing has changed -- a heartbeat, so a silent `perceive` cannot be
# mistaken for a calm night (HANDOFF.md rule 4), the same reasoning behind
# `CAPTURE_IDLE_FPS`.
PERCEIVE_HEARTBEAT_SECONDS=60

# `perceive`: path to the caregiver-drawn bed/door/bathroom-path zones
# yaml (issue #8), as a path inside the container. The compose file mounts
# ./config on the host to /app/config, so this is ./config/zones.yaml on
# the host. Falls back to zones.example.yaml in the same directory if
# missing, and to "everything is zone 'other'" if neither exists --
# logged, not fatal.
ZONES_PATH=/app/config/zones.yaml

# `perceive` (issue #9): whether to send frames to the local Ollama vision
# model at all. `false` skips the vision path entirely -- `scene_note`
# stays `None` on every `PersonState`, and no `OllamaVisionClient` is ever
# built, so there is no Ollama dependency at runtime.
PERCEIVE_VISION_ENABLED=true

# `perceive`: the Ollama model `perceive` sends frames to for scene notes.
# `moondream` matches CLAUDE.md's prerequisites (`ollama pull moondream`).
PERCEIVE_VISION_MODEL=moondream

# `perceive`: seconds between scene-note requests while a session is
# `ENGAGED` and the classified state has not changed (PLAN.md section
# 6.1: "every 60 s while ENGAGED"). A state change fires a request
# immediately regardless of this interval.
PERCEIVE_VISION_INTERVAL_SECONDS=60

# `perceive`: request timeout, in seconds, for one Ollama vision call. A
# vision model on CPU can take several seconds for one frame; this bounds
# how long a single background request is allowed to hang before it is
# treated as a failure (`scene_note` stays unset, `perceive` is otherwise
# unaffected -- the call runs off the frame-processing path entirely).
PERCEIVE_VISION_TIMEOUT_SECONDS=10

# `perceive` (docs/FLOOR_DETECTION_HANDOFF.md section 4/9): a detection's
# box-top height above the self-calibrated ground line, divided by a
# standing person's expected height there, at or below this counts towards
# `on_floor` once two consecutive detections outside the bed zone agree.
# Catches sitting/kneeling/foreshortened floor postures the lying-extent
# and PERCEIVE_FLOOR_TOP_Y rules miss. Needs a ground line
# (PERCEIVE_GROUND_LINE, or enough standing/walking frames to fit one
# online) to have any effect at all; with neither, this rule cannot fire.
PERCEIVE_FLOOR_HEIGHT_RATIO=0.6

# `perceive`: how long a recent upright detection (height_ratio >= 0.8)
# keeps counting as the reference point a fall is measured from. If a
# later detection's box top has risen PERCEIVE_FALL_DROP since, within
# this many seconds, `perceive` reports `on_floor` from a single detection
# -- bypassing PERCEIVE_MIN_CONFIDENCE and the two-consecutive check above.
# Short by design: a real fall completes in a couple of seconds, while an
# ordinary sit-down spreads the same box-top change over many more.
PERCEIVE_FALL_WINDOW_SECONDS=2.5

# `perceive`: minimum rise in bounding-box top (0.0-1.0, frame fraction)
# since the PERCEIVE_FALL_WINDOW_SECONDS-old upright reference to call it
# a fall drop.
PERCEIVE_FALL_DROP=0.15

# `perceive`: how long the read-only "floor suspect" signal stays set
# after a fall drop is observed and the person is then lost entirely (no
# detection at all), before giving up on the suspicion. On its own this
# never reports `on_floor` and only prevents `absent` while it is set; a
# future vision check can read it to look more closely.
PERCEIVE_FLOOR_SUSPECT_SECONDS=20

# `perceive`: explicit "a,b" override for the ground line
# PERCEIVE_FLOOR_HEIGHT_RATIO and the fall-drop rule use
# (height = a * ground_y + b). Empty, the default, means "learn it online"
# from confirmed standing/walking frames instead; set this to skip that
# and pin a known-good calibration, or to disable it in a test.
PERCEIVE_GROUND_LINE=

# `perceive`: path to persist the latest online-fitted ground line to, and
# to load one from at startup, so a container restart is not blind to a
# calibration a previous run already found. Empty, the default, disables
# persistence: nothing is read or written. Suggested value:
# /app/data/perceive/ground_line.json (./data/perceive/ground_line.json on
# the host, since ./data is mounted into every container). Ignored when
# PERCEIVE_GROUND_LINE is set.
PERCEIVE_GROUND_LINE_FILE=

# `perceive`: whether an ambiguous floor situation (a fall-drop-then-lost
# suspicion, a person lost outside the bed, or a low, sustained height
# ratio while sitting outside the bed) gets a local vision-model second
# opinion that can upgrade it to `on_floor`. `false` skips the check
# entirely -- no `OllamaFloorCheckClient` is ever built, so there is no
# Ollama dependency at runtime. This can only add an `on_floor` report; it
# never vetoes or delays a pose-based one.
PERCEIVE_FLOOR_CHECK_ENABLED=true

# `perceive`: the Ollama model the floor check sends frames to. Distinct
# from PERCEIVE_VISION_MODEL (scene notes): this call asks a fixed
# yes/no-plus-confidence question with a JSON schema `format` and
# temperature 0, which needs a model capable of following a schema. A local
# 14-frame benchmark found gemma4:e4b-mlx answered in ~1.6s and got 13/14
# right (one false positive on a person who had just fallen onto the bed,
# not the floor -- PERCEIVE_FLOOR_CHECK_REQUIRED_POSITIVES below is the
# safeguard for exactly that). qwen3-vl:8b was also tried but took 12-32s
# per call, too slow for a repeated check, and returns empty content if a
# "think" field is ever added to the request alongside the JSON format.
PERCEIVE_FLOOR_CHECK_MODEL=gemma4:e4b-mlx

# `perceive`: disable gemma4 thinking, which makes checks slow and can
# produce malformed content; set empty, `auto`, or `unset` to omit the field.
PERCEIVE_FLOOR_CHECK_THINK=false

# `perceive`: request timeout, in seconds, for one floor-check Ollama call.
# Runs off the frame-processing path entirely (perceive.floor_check
# .FloorCheckScheduler), so a slow model costs this check's latency, never
# perceive's frame loop.
PERCEIVE_FLOOR_CHECK_TIMEOUT_SECONDS=20

# `perceive`: minimum seconds between floor-check triggers. Bounds how
# often perceive asks Ollama, on top of "at most one in flight", so a
# sustained ambiguous situation does not fire a new request every frame.
# Skipped down to a ~1s minimum for the follow-up check(s)
# PERCEIVE_FLOOR_CHECK_REQUIRED_POSITIVES needs, once the first qualifying
# positive answer has come in, so confirming or ruling out a suspected fall
# does not wait out the full cooldown twice.
PERCEIVE_FLOOR_CHECK_COOLDOWN_SECONDS=10

# `perceive`: minimum confidence a `person_on_floor=true` floor-check
# answer needs before perceive counts it. Below this, or on a `false`
# answer, or on any failed/timed-out call, nothing changes and any
# in-progress streak of qualifying answers resets -- the vision model
# never overrides pose-based classification, only adds to it.
PERCEIVE_FLOOR_CHECK_MIN_CONFIDENCE=0.6

# `perceive`: consecutive qualifying floor-check answers, on distinct
# frames, required before perceive forces `on_floor`. A single-answer
# benchmark false positive (a person who had just fallen onto the bed, not
# the floor) is why this defaults to 2 rather than 1: any negative or
# unqualifying answer, or the trigger condition itself no longer holding,
# resets the count to zero.
PERCEIVE_FLOOR_CHECK_REQUIRED_POSITIVES=2

# `listen` (issue #18): faster-whisper model and local CPU inference settings.
# The English-only `small.en` model and int8 CPU execution are the fixed v1
# defaults. The model is loaded lazily on the first complete utterance.
LISTEN_MODEL=small.en
# Model weights are not personal data, but keeping them on the mounted data
# volume avoids downloading them again when the container is recreated.
LISTEN_MODEL_CACHE=/app/data/models/faster-whisper
LISTEN_DEVICE=cpu
LISTEN_COMPUTE_TYPE=int8

# `listen`: WebRTC VAD aggressiveness, from 0 (least filtering) to 3 (most).
# Level 2 is a balanced default for a quiet bedroom.
LISTEN_VAD_AGGRESSIVENESS=2

# `listen`: close an utterance after this many milliseconds of silence, and
# ignore speech bursts shorter than LISTEN_MIN_SPEECH_MS. These bounds keep
# clicks and bedding noise out while preserving short needs such as "water".
LISTEN_END_SILENCE_MS=600
LISTEN_MIN_SPEECH_MS=180

# `listen`: force a boundary after this many seconds even if VAD sees
# continuous speech, bounding both memory and transcription latency.
LISTEN_MAX_UTTERANCE_SECONDS=15

# `listen`: WebRTC VAD must stay continuously positive for this long, then
# bundled Silero must confirm speech before playback can be interrupted.
# Embodiment playback activity selects the longer threshold during speech.
LISTEN_BARGE_IN_MS=600
LISTEN_BARGE_IN_WHILE_SPEAKING_MS=1500

# `agent` (issue #12): the night window the session state machine may
# *start a nudging session* in (i.e. begin talking to the person through
# the embodiment page), as local `HH:MM` in the `TZ` configured above.
# Wraps midnight when AGENT_NIGHT_END is earlier in the day than
# AGENT_NIGHT_START, which the defaults below always do. Setting both to
# the same value is treated as "always on" (a 24-hour window), not "never
# on". This window does NOT gate HANDOFF.md rule 5 (on_floor/absent
# escalation): a person on the floor at 3pm still needs help, and
# `perceive` watches around the clock regardless of what `agent` is doing.
AGENT_NIGHT_START=21:00
AGENT_NIGHT_END=07:00

# `agent`: seconds `OBSERVING` waits for the person to either settle back
# `in_bed` or stay up, before moving on to `ENGAGED` on its own (an
# `Utterance` moves it there sooner). HANDOFF.md section 11 is explicit
# this delay must stay configurable rather than be skipped for a faster
# demo; default 20s.
AGENT_OBSERVE_SECONDS=20

# `agent`: seconds `COOLDOWN` holds before returning to `IDLE`. No new
# session may start while `COOLDOWN` is active.
AGENT_COOLDOWN_SECONDS=300

# `agent`: seconds `in_bed` must hold unbroken before the machine leaves
# `ENGAGED`/`ESCALATED` for `COOLDOWN`.
AGENT_IN_BED_STABLE_SECONDS=120

# `agent`: how long `on_floor` is tolerated, from any phase with a live
# session, before HANDOFF.md rule 5 fires and skips every strategy
# straight to `ESCALATED`. Default 0 -- escalate on the very first
# classified frame -- because `on_floor` is the single highest-risk state
# this system observes and, unlike being out of camera view, there is no
# everyday reason for it, so there is no grace period to justify.
AGENT_FLOOR_LIMIT_SECONDS=0

# `agent`: how long `absent` is tolerated before rule 5 fires the same
# way. Ten minutes, not zero, because someone out of camera view at night
# is ordinarily just using the bathroom -- normal and expected -- whereas
# lying on the floor never is; that asymmetry is why `absent` gets a
# grace period and `on_floor` does not.
AGENT_ABSENT_LIMIT_SECONDS=600

# `agent`: how long the `restroom` goal (issue #13) is allowed to sit
# unresolved before the session gives up waiting for the person to be
# seen back at the bed and returns the goal to `return_to_bed` on its
# own. A safety valve against the goal sticking forever, not a claim
# that 15 minutes means anything about actual bathroom use.
AGENT_RESTROOM_TIMEOUT_SECONDS=900

# `agent`: how many consecutive `PersonState` readings must agree on a
# zone before that zone may drive a goal change. `perceive` puts no
# hysteresis on `zone` itself (only on `state`), and `bathroom_path` sits
# right next to `bed`, exactly where a bathroom trip starts, so a single
# noisy reading must not be enough to flip the goal and spam the
# caregiver's timeline. Same default as PERCEIVE_CONFIRM_FRAMES, for the
# same reason. Never applied to rule 5, which always fires immediately.
AGENT_ZONE_CONFIRM_READINGS=3

# `agent` (issue #14): the minimum silence, in seconds, enforced between
# one published `Say` and the next (HANDOFF.md rule 3: "one sentence, then
# silence for at least 8 seconds"). Enforced by `agent.rules.validate_say`
# regardless of which strategy or, eventually, `compose` (issue #15)
# produced the text -- a `Say` that would violate this is never published.
AGENT_SAY_MIN_GAP_SECONDS=8

# `agent`: after a person says they are going back to bed, pause ordinary
# strategy advancement; avoid repeating a strategy spoken recently.
AGENT_COMPLIANCE_GRACE_SECONDS=120
AGENT_REPEAT_WINDOW_SECONDS=120

# `agent` (issue #14): path to the caregiver-editable strategy catalogue
# yaml -- order, enable/disable, cooldown, dwell, and every phrase for
# strategies 1-5 and 10 (HANDOFF.md section 7) -- as a path inside the
# container. The compose file mounts ./config on the host to /app/config,
# so this is ./config/strategies.yaml on the host. Falls back to
# strategies.example.yaml in the same directory if missing, and to the
# built-in defaults in `agent.strategies` if neither exists -- logged, not
# fatal, same convention as ZONES_PATH.
STRATEGIES_PATH=/app/config/strategies.yaml

# `agent`: set to `true` to run the M0 dev fixture (`agent.fake`) instead
# of the real session state machine -- cycles all `Show` states with no
# perception, LLM, or session machine in the loop (HANDOFF.md section 8's
# M0 done criteria, still referenced by CLAUDE.md). Default is the real
# agent.
AGENT_FAKE=false

# `light` (issue #21): hardware control is off by default. When enabled,
# the service consumes absolute on/off commands for the hallway path light
# and calls a Shelly Gen2+ switch over the local LAN; no command leaves the
# home network. The disabled mode still consumes commands and logs them, so
# the full flow remains testable without a smart plug.
LIGHT_ENABLED=false
LIGHT_BACKEND=shelly

# Base URL of the Shelly device, required only when LIGHT_ENABLED=true.
# Example: http://192.168.1.50 (do not include /rpc/Switch.Set).
LIGHT_DEVICE_URL=

# Shelly switch component id and per-command HTTP timeout.
LIGHT_SWITCH_ID=0
LIGHT_TIMEOUT_SECONDS=3

# ntfy topic URL the `notify` service posts caregiver alerts to
# (HANDOFF.md section 2: "ntfy by default"). Use a public https://ntfy.sh/
# topic (pick a hard-to-guess name) or a self-hosted server's topic URL.
# If unset, `notify` logs alerts instead of sending them.
NTFY_URL=https://ntfy.sh/night-companion-changeme
