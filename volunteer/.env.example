# Volunteer upload site. Copy to volunteer/.env and fill in; never commit .env.

PUBLIC_HOSTNAME=upload.mathiasvissers.com
CLOUDFLARE_ZONE_NAME=mathiasvissers.com
CLOUDFLARE_ACCOUNT_ID=

# Scoped API token, not the global key. Permissions:
#   Account > Cloudflare Tunnel > Edit
#   Account > Turnstile > Edit
#   Zone (mathiasvissers.com) > DNS > Edit
CLOUDFLARE_API_TOKEN=

# Written by the Cloudflare setup script; leave empty.
CLOUDFLARE_TUNNEL_TOKEN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Absolute paths on the Mac mini, outside the repository.
VOLUNTEER_DATA_DIR=/Users/mathiasserver/Documents/data-ai-agent-dementia/volunteer_clips
VOLUNTEER_KEY_DIR=/Users/mathiasserver/Documents/data-ai-agent-dementia/volunteer_keys
EVAL_DATA_DIR=/Users/mathiasserver/Documents/data-ai-agent-dementia

SAMPLE_CLIP=2026-09-13_bedroom-sample-02
MAX_RECORDING_SECONDS=300
MAX_UPLOAD_MB=500

# CPU cap for the analysis worker, so the bedside stack keeps its share.
WORKER_CPUS=4
