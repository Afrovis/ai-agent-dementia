# Volunteer upload site. Copy to volunteer/.env and fill in; never commit .env.

PUBLIC_HOSTNAME=upload.example.com
CLOUDFLARE_ZONE_NAME=example.com
CLOUDFLARE_ACCOUNT_ID=

# Scoped API token, not the global key. Permissions:
#   Account > Cloudflare Tunnel > Edit
#   Account > Turnstile > Edit
#   Zone (your zone) > DNS > Edit
CLOUDFLARE_API_TOKEN=

# Written by the Cloudflare setup script; leave empty.
CLOUDFLARE_TUNNEL_TOKEN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Absolute paths on the host, outside the repository (the sibling
# data-ai-agent-dementia directory keeps recordings out of git).
VOLUNTEER_DATA_DIR=/absolute/path/to/data-ai-agent-dementia/volunteer_clips
VOLUNTEER_KEY_DIR=/absolute/path/to/data-ai-agent-dementia/volunteer_keys
EVAL_DATA_DIR=/absolute/path/to/data-ai-agent-dementia

SAMPLE_CLIP=2026-09-13_bedroom-sample-02
MAX_RECORDING_SECONDS=300
MAX_UPLOAD_MB=500

# CPU cap for the analysis worker, so the bedside stack keeps its share.
WORKER_CPUS=4
